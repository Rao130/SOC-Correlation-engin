# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database Configuration
DATABASE_TYPE=mongodb
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=soc_correlation_engine
REDIS_URL=redis://localhost:6379

# JWT Configuration
SECRET_KEY=your_super_secret_jwt_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External API Keys
VIRUSTOTAL_API_KEY=your_virustotal_api_key
ABUSEIPDB_API_KEY=your_abuseipdb_api_key
OTX_API_KEY=your_otx_api_key
SHODAN_API_KEY=your_shodan_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Email Configuration (for alert notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/soc_engine.log

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Alert Processing
ALERT_BATCH_SIZE=100
CORRELATION_TIME_WINDOW=3600000
CRITICALITY_THRESHOLD=7.5

# WebSocket Configuration
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=5000

# GeoIP Database
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# Machine Learning
ML_MODEL_UPDATE_INTERVAL=86400000
ANOMALY_THRESHOLD=0.85
