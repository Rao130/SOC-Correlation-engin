# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/soc_correlation_engine
MONGODB_TEST_URI=mongodb://localhost:27017/soc_correlation_engine_test

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# External API Keys
VIRUSTOTAL_API_KEY=your_virustotal_api_key
ABUSEIPDB_API_KEY=your_abuseipdb_api_key
OTX_API_KEY=your_otx_api_key
SHODAN_API_KEY=your_shodan_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Email Configuration (for alert notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/soc_engine.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Alert Processing
ALERT_BATCH_SIZE=100
CORRELATION_TIME_WINDOW=3600000
CRITICALITY_THRESHOLD=7.5

# WebSocket Configuration
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=5000

# GeoIP Database
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# Machine Learning
ML_MODEL_UPDATE_INTERVAL=86400000
ANOMALY_THRESHOLD=0.85
