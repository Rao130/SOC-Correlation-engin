# =============================================================================
# SOC CORRELATION ENGINE - PRODUCTION CONFIGURATION
# Copy to .env and update with your actual values
# =============================================================================

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
APP_NAME="SOC Correlation Engine"
VERSION="2.0.0"
DEBUG=False
HOST="0.0.0.0"
PORT=8000

# =============================================================================
# SECURITY - CRITICAL: Generate strong random values before production
# =============================================================================

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="your-super-secret-key-change-in-production-min-64-chars-!@#$%^&*()"

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
ENCRYPTION_MASTER_SECRET="your-encryption-master-secret-change-in-production-min-64-chars-!@#$%^&*()"

# JWT Configuration
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
TOKEN_ROTATION_ENABLED=true

# Session Management
SESSION_TIMEOUT_MINUTES=30

# CORS - Specify allowed origins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000"

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB
DATABASE_TYPE="mongodb"
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="soc_correlation_engine"

# Docker MongoDB Configuration
MONGO_PASSWORD="admin123"
MONGO_ROOT_PASSWORD="admin123"

# =============================================================================
# CACHE & SESSIONS (Redis)
# =============================================================================
REDIS_URL="redis://localhost:6379"

# Docker Redis Configuration
REDIS_PASSWORD="admin123"

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Grafana
GRAFANA_PASSWORD="admin123"

# RabbitMQ
RABBITMQ_USER="admin"
RABBITMQ_PASSWORD="admin123"

# =============================================================================
# RATE LIMITING & SECURITY
# =============================================================================

# Rate Limiting - Requests per time window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Brute Force Protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Burst Protection (DDoS mitigation)
BURST_THRESHOLD=50
BURST_COOLDOWN_SECONDS=300

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# =============================================================================
# EXTERNAL API KEYS (Threat Intelligence & Reputation)
# =============================================================================

# VirusTotal
VIRUSTOTAL_API_KEY="your-virustotal-api-key"

# AbuseIPDB
ABUSEIPDB_API_KEY="your-abuseipdb-api-key"

# AlienVault OTX
OTX_API_KEY="your-otx-api-key"

# Shodan
SHODAN_API_KEY="your-shodan-api-key"

# Google Maps
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL="INFO"
LOG_FILE="logs/soc_engine.log"
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# =============================================================================
# ALERT PROCESSING
# =============================================================================
ALERT_BATCH_SIZE=100
CORRELATION_TIME_WINDOW=3600000
CRITICALITY_THRESHOLD=7.5

# =============================================================================
# BACKGROUND TASKS & MAINTENANCE
# =============================================================================
BACKGROUND_TASK_INTERVAL=60
CLEANUP_INTERVAL=3600

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
WS_PING_INTERVAL=25
WS_PING_TIMEOUT=5

# =============================================================================
# GEOIP CONFIGURATION
# =============================================================================
GEOIP_DB_PATH="data/GeoLite2-City.mmdb"
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# Machine Learning
ML_MODEL_UPDATE_INTERVAL=86400000
ANOMALY_THRESHOLD=0.85
